{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChromeTester",
  "version": "0.1.3",
  "identifier": "com.cvm.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ChromeTester",
        "width": 1000,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
